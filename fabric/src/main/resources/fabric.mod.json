{
  "schemaVersion": 1,
  "id": "notenoughrainsounds",
  "version": "${version}",
  "name": "Not Enough Rain Sounds",
  "description": "Material-aware rain and carefully designed sound details for Minecraft.",
  "authors": [
    "tozyx"
  ],
  "contact": {
    "sources": "https://github.com/tozyx/NotEnoughRainSounds",
    "issues": "https://github.com/tozyx/NotEnoughRainSounds/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "mixins": [
    "notenoughrainsounds.client.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "com.tozyx.notenoughrainsounds.fabric.NotEnoughRainSoundsFabricClient"
    ],
    "modmenu": [
      "com.tozyx.notenoughrainsounds.fabric.NotEnoughRainSoundsModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
